<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/layered_drawable.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape xmlns:android="http://schemas.android.com/apk/res/android">
            <gradient
                android:startColor="#251191"
                android:endColor="#5a45d1"
                android:angle="45"
                />
        </shape>
    </item>

    <!-- Circle at the bottom-left corner -->
    <item
        android:left="0dp"
        android:bottom="0dp"
        android:right="100dp"
        android:top="100dp">
        <shape
            android:shape="oval">
            <!-- Adjust alpha value for transparency -->
            <solid android:color="#4C000000"/>
        </shape>
    </item>
</layer-list>
